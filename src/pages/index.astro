---
import Layout from '../layouts/Layout.astro';
// import HeroAnimation from '../components/HeroAnimation.astro';

const newsItems = [
  {
    date: '2026-06-01',
    dateLabel: '2026.06.01',
    category: 'プロジェクト',
    title: '能登アップサイクルプラットフォーム事務局を開設しました（7団体）',
    href: '/news/2026-06-noto-upcycle',
  },
  {
    date: '2025-07-01',
    dateLabel: '2025.07.01',
    category: 'お知らせ',
    title: '金丸商店株式会社として事業を継承しました',
    href: '/news/2025-07-founding',
  },
  {
    date: '2025-09-05',
    dateLabel: '2025.09.05',
    category: 'Instagram',
    title: 'あばれ祭の季節。宇出津の夏を、今年も迎えました。',
    href: 'https://www.instagram.com/kanemaru.inc/',
    external: true,
  },
];

const dewoni = [
  {
    particle: 'で',
    label: '日々を営む',
    group: 'de',
    href: '/business#de',
    businesses: ['かねまる', '漁心庵', '能登屋', 'NASW'],
  },
  {
    particle: 'を',
    label: '土地を継ぐ',
    group: 'wo',
    href: '/business#wo',
    businesses: ['工務店あおばち組', 'nowtocura のとくら'],
  },
  {
    particle: 'に',
    label: '人を迎える',
    group: 'ni',
    href: '/business#ni',
    businesses: ["HERO's Labo"],
  },
];
---

<Layout
  title="金丸商店株式会社 | 能登・宇出津"
  description="大正7年、能登町宇出津の氷水屋から始まった金丸商店。共同代表 小川勝則・小川楽生が2025年7月に株式会社として継承し、「共暮らし」をテーマに7つの事業を営んでいます。"
>

  {/* <HeroAnimation /> */}

  <!-- =====================
       News Banner
       ===================== -->
  <div class="news-banner" id="news-banner">
    <div class="news-banner__trigger" role="button" aria-expanded="false" aria-controls="news-banner-body" tabindex="0">
      <span class="news-banner__dot" aria-hidden="true"></span>
      <span class="news-banner__label">お知らせ</span>
      <span class="news-banner__title">かき氷・たい焼きの販売について</span>
      <svg class="news-banner__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
    <div class="news-banner__body" id="news-banner-body" role="region" aria-label="バナー本文">
      <div class="news-banner__body-inner">
        みなさまから、かき氷・たい焼きのキッチンカー販売について多数のお問い合わせをいただいております。不定期開催につき、開催が決まり次第、インスタグラムおよびフェイスブックでお知らせいたします。ぜひフォロー・メッセージください。
      </div>
    </div>
  </div>

  <!-- =====================
       Hero
       ===================== -->
  <section class="hero" aria-label="メインビジュアル">
    <div class="hero__inner">
      <div class="hero__left">
        <span class="hero__label">Kanemaru Shoten, Ushitsu, Noto</span>
        <p class="hero__sub">氷水屋から、<br />暮らしの事業へ。</p>
        <a href="/about" class="link-arrow hero__cta">あり方を読む</a>
      </div>
      <h1 class="hero__catch" aria-label="能登でをに、暮らす。">
        能登でをに、暮らす。
      </h1>
    </div>
    <div class="hero__scroll" aria-hidden="true">
      <div class="hero__scroll-line"></div>
      <span>Scroll</span>
    </div>
  </section>

  <!-- =====================
       でをにダイアグラム
       ===================== -->
  <section class="dewoni-section section" aria-label="事業構造">
    <div class="container">
      <div class="section-header dewoni-section__header">
        <img src="/250ppi/Artboard%204.png" alt="" class="dewoni-section__logo" aria-hidden="true" />
        <div>
          <span class="section-label">Business Structure</span>
          <h2 class="section-title">能登でをに、暮らす。</h2>
        </div>
      </div>
      <p class="dewoni-section__lead">
        「で」「を」「に」という三つの助詞が、金丸商店の事業構造そのものです。
        <a href="/business" class="link-inline">7つの事業を見る</a>
      </p>
      <div class="dewoni">
        {dewoni.map(g => (
          <a href={g.href} class={`dewoni__panel dewoni__panel--${g.group}`} aria-label={`${g.particle}｜${g.label}`}>
            <div class="dewoni__head">
              <span class="dewoni__particle">{g.particle}</span>
              <span class="dewoni__label">{g.label}</span>
            </div>
            <ul class="dewoni__list">
              {g.businesses.map(b => <li>{b}</li>)}
            </ul>
            <span class="dewoni__more">事業を見る →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================
       News preview
       ===================== -->
  <section class="news-preview section" aria-label="お知らせ">
    <div class="container">
      <div class="section-header">
        <span class="section-label">News</span>
        <h2 class="section-title">お知らせ</h2>
      </div>
      <div class="news-layout">
        <div class="news-layout__left">
          <ul class="news-list">
            {newsItems.map(item => (
              <li class="news-item fade-in">
                <a
                  href={item.href}
                  class="news-item__link"
                  {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <time class="news-item__date" datetime={item.date}>{item.dateLabel}</time>
                  <span class="news-item__category">{item.category}</span>
                  <span class="news-item__title">{item.title}</span>
                  {item.external && (
                    <svg class="news-item__ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15 3 21 3 21 9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
          <div class="news-preview__more">
            <a href="/news" class="link-arrow">お知らせ一覧</a>
          </div>
        </div>

        <div class="news-layout__right">
          <div class="insta-embed-wrap">
            <div class="insta-embed-header">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
              </svg>
              <span class="insta-embed-label">@kanemaru.inc の最新投稿</span>
              <a href="https://www.instagram.com/kanemaru.inc/" target="_blank" rel="noopener noreferrer" class="insta-embed-follow">フォロー</a>
            </div>
            <!--
              【投稿の更新方法】
              1. Instagramで表示したい投稿を開く
              2. 右上「…」→「埋め込み」をタップ
              3. 表示されたURLをコピーして下の data-instgrm-permalink に貼り付ける
            -->
            <blockquote
              class="instagram-media"
              data-instgrm-captioned
              data-instgrm-permalink="https://www.instagram.com/kanemaru.inc/"
              data-instgrm-version="14"
              style="background:#FAF8F4; border:0; border-radius:0; box-shadow:none; margin:0 !important; min-width:100%; width:100%;"
            >
              <div class="insta-embed-loading">
                <a href="https://www.instagram.com/kanemaru.inc/" target="_blank" rel="noopener noreferrer">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <circle cx="12" cy="12" r="4"/>
                    <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
                  </svg>
                  <span>@kanemaru.inc</span>
                </a>
              </div>
            </blockquote>
            <script is:inline async src="https://www.instagram.com/embed.js"></script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================
       Members teaser
       ===================== -->
  <section class="members-teaser" aria-label="人">
    <div class="container">
      <div class="members-teaser__inner">
        <div class="members-teaser__text">
          <span class="section-label">Members</span>
          <h2 class="members-teaser__title">共に営む人</h2>
          <p class="members-teaser__body">
            孫と、ひ孫と。大正から続く問いを、二人で引き受けています。
          </p>
          <a href="/members" class="link-arrow">人を見る</a>
        </div>
        <div class="members-teaser__faces">
          <div class="member-face">
            <div class="member-face__photo member-face__photo--placeholder" aria-label="小川勝則の写真"></div>
            <span class="member-face__name">小川 勝則</span>
            <span class="member-face__role">共同代表</span>
          </div>
          <div class="member-face">
            <div class="member-face__photo member-face__photo--placeholder" aria-label="小川楽生の写真"></div>
            <span class="member-face__name">小川 楽生</span>
            <span class="member-face__role">共同代表</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ─── News Banner ─── */

  .news-banner {
    position: sticky;
    top: 72px;
    z-index: 80;
    background: rgba(43, 38, 34, 0.97);
    border-bottom: 1px solid rgba(250, 248, 244, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
  }

  .news-banner__trigger {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--side-pad);
    height: 48px;
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    user-select: none;
  }

  .news-banner__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--shu);
    flex-shrink: 0;
    animation: dotPulse 2.4s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  .news-banner__label {
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--shu);
    white-space: nowrap;
    flex-shrink: 0;
    border: 1px solid rgba(192, 57, 27, 0.5);
    padding: 2px 8px;
  }

  .news-banner__title {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: rgba(250, 248, 244, 0.85);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .news-banner__chevron {
    color: rgba(250, 248, 244, 0.45);
    flex-shrink: 0;
    transition: transform var(--dur) var(--ease);
  }

  .news-banner__body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.38s var(--ease);
  }

  .news-banner:hover .news-banner__body,
  .news-banner.is-open .news-banner__body {
    max-height: 160px;
  }

  .news-banner:hover .news-banner__chevron,
  .news-banner.is-open .news-banner__chevron {
    transform: rotate(180deg);
  }

  .news-banner__body-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 14px var(--side-pad) 20px;
    font-size: 13px;
    line-height: 2;
    letter-spacing: 0.06em;
    color: rgba(250, 248, 244, 0.68);
    border-top: 1px solid rgba(250, 248, 244, 0.08);
  }

  /* ─── Hero ─── */

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(64px, 8vh, 100px);
    background-color: var(--ink);
  }

  .hero__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--side-pad);
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  .hero__left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 8px;
  }

  .hero__label {
    display: block;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(250, 248, 244, 0.38);
  }

  .hero__sub {
    font-family: var(--font-serif);
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 500;
    line-height: 2;
    letter-spacing: 0.1em;
    color: rgba(250, 248, 244, 0.72);
  }

  .hero__cta {
    color: rgba(250, 248, 244, 0.72);
    width: fit-content;
  }

  .hero__catch {
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    font-size: clamp(28px, 4.5vw, 60px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.18em;
    color: var(--paper);
    flex-shrink: 0;
  }

  .hero__scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(250, 248, 244, 0.35);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero__scroll-line {
    width: 1px;
    height: 36px;
    background: rgba(250, 248, 244, 0.3);
    animation: scrollLine 2.2s var(--ease) infinite;
    transform-origin: top;
  }

  @keyframes scrollLine {
    0%   { transform: scaleY(0); opacity: 0; }
    40%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* ─── でをにダイアグラム ─── */

  .dewoni-section__header {
    flex-direction: row;
    align-items: center;
    gap: 28px;
  }

  .dewoni-section__logo {
    width: 220px;
    height: auto;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .dewoni-section__lead {
    font-size: 15px;
    line-height: 2;
    color: var(--gray);
    margin-bottom: 48px;
    max-width: 560px;
  }

  .link-inline {
    color: var(--shu);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dewoni {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
  }

  .dewoni__panel {
    padding: clamp(28px, 4vw, 48px) clamp(20px, 3vw, 36px);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: background var(--dur) var(--ease);
    text-decoration: none;
  }

  .dewoni__panel:last-child {
    border-right: none;
  }

  .dewoni__panel--de { background: color-mix(in srgb, var(--de) 6%, var(--paper)); }
  .dewoni__panel--wo { background: color-mix(in srgb, var(--wo) 6%, var(--paper)); }
  .dewoni__panel--ni { background: color-mix(in srgb, var(--ni) 6%, var(--paper)); }

  .dewoni__panel--de:hover { background: color-mix(in srgb, var(--de) 10%, var(--paper)); }
  .dewoni__panel--wo:hover { background: color-mix(in srgb, var(--wo) 10%, var(--paper)); }
  .dewoni__panel--ni:hover { background: color-mix(in srgb, var(--ni) 10%, var(--paper)); }

  .dewoni__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 16px;
    border-bottom: 1px solid;
  }

  .dewoni__panel--de .dewoni__head { border-color: var(--de); }
  .dewoni__panel--wo .dewoni__head { border-color: var(--wo); }
  .dewoni__panel--ni .dewoni__head { border-color: var(--ni); }

  .dewoni__particle {
    font-family: var(--font-serif);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
  }

  .dewoni__panel--de .dewoni__particle { color: var(--de); }
  .dewoni__panel--wo .dewoni__particle { color: var(--wo); }
  .dewoni__panel--ni .dewoni__particle { color: var(--ni); }

  .dewoni__label {
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--gray);
  }

  .dewoni__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .dewoni__list li {
    font-size: 14px;
    color: var(--ink);
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  .dewoni__more {
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--gray);
    margin-top: auto;
  }

  /* ─── News preview ─── */

  .news-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 56px;
    align-items: start;
  }

  .news-layout__left {}

  .news-layout__right {}

  /* ─── Instagram embed ─── */

  .insta-embed-wrap {
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--paper);
  }

  .insta-embed-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--gray);
  }

  .insta-embed-label {
    font-size: 12px;
    letter-spacing: 0.08em;
    flex: 1;
    color: var(--gray);
  }

  .insta-embed-follow {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--shu);
    border: 1px solid rgba(192, 57, 27, 0.4);
    padding: 3px 10px;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
    white-space: nowrap;
  }

  .insta-embed-follow:hover {
    background: var(--shu);
    color: var(--paper);
    border-color: var(--shu);
  }

  .insta-embed-loading {
    padding: 40px 20px;
    display: flex;
    justify-content: center;
  }

  .insta-embed-loading a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--gray);
    font-size: 13px;
    letter-spacing: 0.1em;
    transition: color var(--dur) var(--ease);
  }

  .insta-embed-loading a:hover {
    color: var(--ink);
  }

  /* Instagram embed.js が注入するiframeの横幅を制御 */
  .insta-embed-wrap .instagram-media {
    margin: 0 !important;
    min-width: 100% !important;
    width: 100% !important;
  }

  .news-list {
    border-top: 1px solid var(--line);
  }

  .news-item {}

  .news-item__link {
    display: grid;
    grid-template-columns: 96px 80px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    transition: padding var(--dur) var(--ease), background var(--dur) var(--ease), margin var(--dur) var(--ease);
  }

  .news-item__link:hover {
    background: color-mix(in srgb, var(--shu) 4%, var(--paper));
    padding-left: 16px;
    padding-right: 16px;
    margin: 0 -16px;
  }

  .news-item__date {
    font-size: 12px;
    color: var(--gray);
    white-space: nowrap;
    letter-spacing: 0.04em;
    font-feature-settings: "tnum";
  }

  .news-item__category {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--gray);
    border: 1px solid var(--line);
    padding: 3px 10px;
    white-space: nowrap;
    text-align: center;
  }

  .news-item__title {
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink);
  }

  .news-item__ext {
    color: var(--gray);
    flex-shrink: 0;
  }

  .news-preview__more {
    margin-top: 40px;
    display: flex;
    justify-content: flex-end;
  }

  /* ─── Members teaser ─── */

  .members-teaser {
    background: var(--ink);
    padding: clamp(80px, 10vw, 140px) 0;
  }

  .members-teaser__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 80px;
    align-items: center;
  }

  .members-teaser__text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .members-teaser__text .section-label {
    color: rgba(250, 248, 244, 0.4);
  }

  .members-teaser__title {
    font-family: var(--font-serif);
    font-size: clamp(24px, 3vw, 38px);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--paper);
    line-height: 1.5;
  }

  .members-teaser__body {
    font-size: 15px;
    line-height: 2;
    color: rgba(250, 248, 244, 0.55);
    max-width: 400px;
  }

  .members-teaser__text .link-arrow {
    color: rgba(250, 248, 244, 0.65);
    width: fit-content;
  }

  .members-teaser__faces {
    display: flex;
    gap: 32px;
    flex-shrink: 0;
  }

  .member-face {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .member-face__photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(250, 248, 244, 0.08);
