  .member-face__role {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: rgba(250, 248, 244, 0.4);
  }

  /* ─── Responsive ─── */

  @media (max-width: 960px) {
    .news-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .news-layout__right {
      max-width: 400px;
    }

    .dewoni-section__header {
      flex-direction: column;
      gap: 20px;
