---
const navItems = [
  { href: '/about',    label: 'あり方' },
  { href: '/business', label: '事業' },
  { href: '/news',     label: 'お知らせ' },
  { href: '/members',  label: '人' },
  { href: '/store',    label: '店' },
  { href: '/company',  label: '会社概要' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="金丸商店 ホームへ">
          <img src="/images/logo-mark.svg" alt="金丸商店" width="140" height="140" class="footer-logo__mark" />
        </a>
        <address class="footer-address">
          <p>石川県鳳珠郡能登町字宇出津へ字29番地1</p>
          <p><a href="tel:0768628100">(0768) 62-8100</a></p>
          <p><a href="mailto:info@kanemaru.ltd">info@kanemaru.ltd</a></p>
        </address>
      </div>

      <nav class="footer-nav" aria-label="フッターナビゲーション">
        {navItems.map(item => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="footer-social">
        <a href="https://www.instagram.com/kanemaru.inc/" class="footer-social__link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
          Instagram
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="copyright">© 2025 金丸商店株式会社</p>
      <p class="copyright">石川県能登町宇出津</p>
    </div>
  </div>
</footer>
