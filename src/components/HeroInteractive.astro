---
// HeroInteractive — 全画面カラートランジション・ヒーロー
// 水 → 森 → 火 → 雪 → 生成り の順に背景が遷移
// カーソル移動でトリガー、4秒後に自動開始
---

<section class="hero-ia" id="hero-ia" aria-label="メインビジュアル">
  <canvas id="hero-ia-cv" class="hero-ia__canvas" aria-hidden="true"></canvas>

  <div class="hero-ia__inner">
    <div class="hero-ia__left">
      <span class="hero-ia__label">Kanemaru Shoten, Ushitsu, Noto</span>
      <p class="hero-ia__sub">氷水屋から、<br />暮らしの事業へ。</p>
      <a href="/about" class="link-arrow hero-ia__cta">あり方を読む</a>
    </div>
    <h1 class="hero-ia__catch" aria-label="能登でをに、暮らす。">
      能登でをに、暮らす。
    </h1>
  </div>

  <div class="hero-ia__scroll" aria-hidden="true">
    <div class="hero-ia__scroll-line"></div>
    <span>Scroll</span>
  </div>
</section>

<style>
  /* ── Hero container ─────────────────────── */
  .hero-ia {
    position: relative;
    min-height: 100vh;
    background: #FFFDF8;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(64px, 8vh, 100px);
  }

  .hero-ia__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    display: block;
  }

  /* ── Layout ─────────────────────────────── */
  .hero-ia__inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--side-pad);
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  /* ── Left content ───────────────────────── */
  .hero-ia__left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 8px;
  }

  .hero-ia__label {
    display: block;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(43, 38, 34, 0.38);
    opacity: 0;
    animation: hiUp 1s ease 1.8s forwards;
  }

  .hero-ia__sub {
    font-family: var(--font-serif);
    font-size: clamp(16px, 2vw, 24px);
    font-weight: 500;
    line-height: 2;
    letter-spacing: 0.1em;
    color: rgba(43, 38, 34, 0.65);
    opacity: 0;
    animation: hiUp 1s ease 2.1s forwards;
  }

  .hero-ia__cta {
    color: rgba(43, 38, 34, 0.6);
    width: fit-content;
    opacity: 0;
    animation: hiUp 1s ease 2.5s forwards;
  }

  @keyframes hiUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Vertical h1 ────────────────────────── */
  .hero-ia__catch {
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    font-size: clamp(28px, 4.5vw, 60px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.18em;
    color: var(--ink);
    flex-shrink: 0;
    /* White halo ensures legibility over any background phase */
    text-shadow:
      0 0 24px rgba(255, 253, 248, 1),
      0 0 56px rgba(255, 253, 248, 0.9),
      0 0 96px rgba(255, 253, 248, 0.6);
  }

  /* ── Scroll indicator ───────────────────── */
  .hero-ia__scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(43, 38, 34, 0.28);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero-ia__scroll-line {
    width: 1px;
    height: 36px;
    background: rgba(43, 38, 34, 0.2);
    transform-origin: top;
    animation: scrollLine 2.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
  }

  @keyframes scrollLine {
    0%   { transform: scaleY(0); opacity: 0; }
    40%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* ── Mobile ─────────────────────────────── */
  @media (max-width: 768px) {
    .hero-ia__inner {
      flex-direction: column-reverse;
      align-items: flex-start;
      padding-bottom: 0;
    }

    .hero-ia__catch {
      writing-mode: horizontal-tb;
      font-size: clamp(28px, 8vw, 40px);
    }
  }

  /* ── Reduced motion ─────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-ia__label,
    .hero-ia__sub,
    .hero-ia__cta { animation: none; opacity: 1; }
    .hero-ia__scroll-line { animation: none; }
  }
</style>

<script>
(function () {
  'use strict'

  /* ── Guards ─────────────────────────────── */
  var section = document.getElementById('hero-ia')
  var canvas  = document.getElementById('hero-ia-cv')
  if (!section || !canvas) return
  var ctx = canvas.getContext('2d')

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (reduced) return

  var DPR = Math.min(window.devicePixelRatio || 1, 2)
  var W = 0, H = 0
  var cx, cy  // cursor position (logical coords)

  /* ──────────────────────────────────────────
     カラーフェーズ定義
     [R, G, B, maxAlpha]
     水 → 森 → 火 → 雪 → 生成り（透明に戻る）
  ────────────────────────────────────────── */
  var PHASES = [
    [148, 196, 222, 0.82],  // 水 — 朝靄の青
    [ 84, 144,  97, 0.80],  // 森 — 若葉の緑
    [193,  97,  41, 0.76],  // 火 — 琥珀の橙
    [211, 223, 232, 0.72],  // 雪 — 冷たい銀白
    [250, 248, 244, 0.00],  // 生成り — 消えて落ち着く
  ]

  /* フェーズ持続時間（秒）*/
  var DUR = [2.6, 2.6, 2.2, 2.0, 3.0]

  /* 開始カラー（白紙） */
  var ORIGIN = [250, 248, 244, 0.0]

  /* ── State ──────────────────────────────── */
  var startTime = null
  var isActive  = false
  var autoTimer = null
  var animId    = null

  /* ── Easing ─────────────────────────────── */
  function ss(t) {
    t = t < 0 ? 0 : t > 1 ? 1 : t
    return t * t * (3 - 2 * t)
  }
  function lerp(a, b, t) { return a + (b - a) * t }

  /* ── Resize ─────────────────────────────── */
  function resize() {
    W = section.clientWidth  || window.innerWidth
    H = section.clientHeight || window.innerHeight
    canvas.width  = Math.round(W * DPR)
    canvas.height = Math.round(H * DPR)
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0)
    if (cx === undefined) { cx = W / 2; cy = H / 2 }
  }

  /* ── Phase interpolation ────────────────── */
  function getColor(now) {
    if (!isActive || startTime === null) return null
    var elapsed = (now - startTime) / 1000
    var rem = elapsed
    var ph  = 0
    while (ph < PHASES.length - 1 && rem >= DUR[ph]) { rem -= DUR[ph]; ph++ }
    if (ph >= PHASES.length) return null  // done

    var t    = ss(rem / DUR[ph])
    var from = ph === 0 ? ORIGIN : PHASES[ph - 1]
    var to   = PHASES[ph]
    return [
      lerp(from[0], to[0], t) | 0,
      lerp(from[1], to[1], t) | 0,
      lerp(from[2], to[2], t) | 0,
      lerp(from[3], to[3], t),
    ]
  }

  /* ── Draw ───────────────────────────────── */
  function draw(now) {
    animId = requestAnimationFrame(draw)
    ctx.clearRect(0, 0, W, H)

    var col = getColor(now)
    if (!col) return

    var R = col[0], G = col[1], B = col[2], A = col[3]
    if (A < 0.004) return

    /* ─ レイヤー1: 全画面ベースカラー（均一塗り）─ */
    ctx.fillStyle = 'rgba(' + R + ',' + G + ',' + B + ',' + (A * 0.68).toFixed(3) + ')'
    ctx.fillRect(0, 0, W, H)

    /* ─ レイヤー2: カーソル中心・広域グラデーション ─
       半径をスクリーン最大辺の 100% に設定し、
       カーソルの影響が画面全体に及ぶようにする        */
    var bigR = Math.max(W, H) * 1.05
    var bR   = Math.min(255, R + 38) | 0
    var bG   = Math.min(255, G + 38) | 0
    var bB   = Math.min(255, B + 38) | 0

    var gBig = ctx.createRadialGradient(cx, cy, 0, cx, cy, bigR)
    gBig.addColorStop(0.00, 'rgba(' + bR + ',' + bG + ',' + bB + ',' + (A * 0.55).toFixed(3) + ')')
    gBig.addColorStop(0.45, 'rgba(' + R  + ',' + G  + ',' + B  + ',' + (A * 0.22).toFixed(3) + ')')
    gBig.addColorStop(1.00, 'rgba(' + R  + ',' + G  + ',' + B  + ',0)')
    ctx.fillStyle = gBig
    ctx.fillRect(0, 0, W, H)

    /* ─ レイヤー3: カーソル付近のより鮮明なグロー ─
       スクリーンの 45% の半径で、より濃い色が集まる  */
    var medR = Math.min(W, H) * 0.45
    var gMed = ctx.createRadialGradient(cx, cy, 0, cx, cy, medR)
    gMed.addColorStop(0.0, 'rgba(' + bR + ',' + bG + ',' + bB + ',' + (A * 0.30).toFixed(3) + ')')
    gMed.addColorStop(0.5, 'rgba(' + R  + ',' + G  + ',' + B  + ',' + (A * 0.08).toFixed(3) + ')')
    gMed.addColorStop(1.0, 'rgba(' + R  + ',' + G  + ',' + B  + ',0)')
    ctx.fillStyle = gMed
    ctx.fillRect(0, 0, W, H)
  }

  /* ── Activate sequence ──────────────────── */
  function activate() {
    if (isActive) return
    isActive  = true
    startTime = performance.now()
    if (autoTimer) { clearTimeout(autoTimer); autoTimer = null }
  }

  /* ── Events ─────────────────────────────── */
  section.addEventListener('mousemove', function (e) {
    var r = section.getBoundingClientRect()
    cx = e.clientX - r.left
    cy = e.clientY - r.top
    activate()
  })

  /* クリックでもトリガー */
  section.addEventListener('click', function (e) {
    var r = section.getBoundingClientRect()
    cx = e.clientX - r.left
    cy = e.clientY - r.top
    activate()
  })

  /* タッチ対応 */
  section.addEventListener('touchstart', function (e) {
    var r = section.getBoundingClientRect(), t = e.touches[0]
    cx = t.clientX - r.left; cy = t.clientY - r.top
    activate()
  }, { passive: true })

  section.addEventListener('touchmove', function (e) {
    var r = section.getBoundingClientRect(), t = e.touches[0]
    cx = t.clientX - r.left; cy = t.clientY - r.top
  }, { passive: true })

  /* ── Resize ─────────────────────────────── */
  if (window.ResizeObserver) {
    new ResizeObserver(resize).observe(section)
  } else {
    window.addEventListener('resize', resize)
  }
  resize()

  /* ── Visibility pause ───────────────────── */
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) cancelAnimationFrame(animId)
    else animId = requestAnimationFrame(draw)
  })

  /* ── Boot ───────────────────────────────── */
  animId = requestAnimationFrame(draw)

  /* 4秒後に自動開始（カーソル未操作の場合）*/
  autoTimer = setTimeout(function () {
    if (!isActive) {
      cx = W / 2; cy = H / 2
      activate()
    }
  }, 4000)

})()
</script>
