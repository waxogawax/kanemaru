---
// HeroInteractive — にじみ合う土地の変化（〜20秒）
// 水が底全体に満ち → 森が生い茂り → 火が宿り → 雪が包む
// 低解像度 Canvas + CSS blur でにじみを表現
// カーソルは起動トリガーのみ（追従なし）
---

<section class="hero-ia" id="hero-ia" aria-label="メインビジュアル">
  <canvas id="hero-ia-cv" class="hero-ia__canvas" aria-hidden="true"></canvas>

  <!-- サブコピー（中央・縦書き・右から左へ出現） -->
  <div class="hero-ia__sub-copy" aria-hidden="true">
    <!--
      flex-direction: row-reverse なので
      DOM の先頭が視覚的に右端 → 右から左の順に出現する
    -->
    <span class="hero-ia__sub-line" data-t="4">能登で。</span>
    <span class="hero-ia__sub-line" data-t="5">能登を。</span>
    <span class="hero-ia__sub-line" data-t="6">能登に。</span>
    <span class="hero-ia__sub-line" data-t="8">暮らしの多様さを、</span>
    <span class="hero-ia__sub-line" data-t="10">ひとつずつ事業にしていく。</span>
  </div>

  <!-- メインコピー（右下・縦書き・アニメ後に出現） -->
  <h1 class="hero-ia__catch" aria-label="能登でをに、暮らす。">
    能登でをに、暮らす。
  </h1>

  <!-- フッターコンテンツ（左下・アニメ後に出現） -->
  <div class="hero-ia__footer">
    <span class="hero-ia__label-en">Kanemaru Shoten, Ushitsu, Noto</span>
    <p class="hero-ia__desc">氷水屋から、暮らしの事業へ。</p>
    <a href="/about" class="link-arrow hero-ia__cta">あり方を読む</a>
  </div>

  <div class="hero-ia__scroll" aria-hidden="true">
    <div class="hero-ia__scroll-line"></div>
    <span>Scroll</span>
  </div>
</section>

<style>
  /* ── セクション ────────────────────────── */
  .hero-ia {
    position: relative;
    min-height: 100vh;
    background: #FFFDF8;
    overflow: hidden;
  }

  /* ── Canvas ─────────────────────────────
     意図的低解像度 → CSS 拡大 → blur でにじみ   */
  .hero-ia__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    display: block;
    filter: blur(12px) saturate(1.14);
    transform: scale(1.06);
    transform-origin: center;
  }

  /* ── サブコピー（中央・縦書き列）────────── */
  .hero-ia__sub-copy {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    flex-direction: row-reverse;   /* DOM 先頭 = 視覚的に右端 */
    align-items: flex-start;
    gap: 1.8em;
    pointer-events: none;
  }

  .hero-ia__sub-line {
    display: block;
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    font-size: clamp(12px, 1.4vw, 16px);
    font-weight: 400;
    letter-spacing: 0.22em;
    line-height: 1.7;
    color: rgba(43, 38, 34, 0.56);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 2.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 2.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hero-ia__sub-line.is-shown {
    opacity: 1;
    transform: none;
  }

  /* ── メインコピー（アニメ後に出現）──────── */
  .hero-ia__catch {
    position: absolute;
    right: clamp(40px, 7vw, 100px);
    bottom: clamp(80px, 14vh, 150px);
    z-index: 2;
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    font-size: clamp(28px, 4.5vw, 60px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.18em;
    color: var(--ink);
    text-shadow:
      0 0 18px rgba(255, 253, 248, 1),
      0 0 40px rgba(255, 253, 248, 1),
      0 0 80px rgba(255, 253, 248, 0.85);
    opacity: 0;
    transform: translateX(10px);
    transition: opacity 2.2s ease 0.3s, transform 2.2s ease 0.3s;
  }

  .hero-ia.is-done .hero-ia__catch {
    opacity: 1;
    transform: none;
  }

  /* ── フッターコンテンツ（アニメ後に出現）── */
  .hero-ia__footer {
    position: absolute;
    bottom: clamp(40px, 7vh, 70px);
    left: clamp(32px, var(--side-pad), 80px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 18px;
    opacity: 0;
    transition: opacity 2s ease 0.9s;
  }

  .hero-ia.is-done .hero-ia__footer {
    opacity: 1;
  }

  .hero-ia__label-en {
    display: block;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(43, 38, 34, 0.34);
  }

  .hero-ia__desc {
    font-family: var(--font-serif);
    font-size: clamp(15px, 1.8vw, 22px);
    font-weight: 500;
    line-height: 2;
    letter-spacing: 0.1em;
    color: rgba(43, 38, 34, 0.60);
  }

  .hero-ia__cta {
    color: rgba(43, 38, 34, 0.56);
    width: fit-content;
  }

  /* ── スクロールインジケーター ─────────── */
  .hero-ia__scroll {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(43, 38, 34, 0.24);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero-ia__scroll-line {
    width: 1px;
    height: 36px;
    background: rgba(43, 38, 34, 0.18);
    transform-origin: top;
    animation: scrollLine 2.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
  }

  @keyframes scrollLine {
    0%   { transform: scaleY(0); opacity: 0; }
    40%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* ── モバイル ────────────────────────── */
  @media (max-width: 768px) {
    .hero-ia__catch {
      font-size: clamp(24px, 7vw, 36px);
      right: clamp(20px, 5vw, 48px);
      bottom: clamp(100px, 18vh, 160px);
    }
    .hero-ia__sub-copy {
      gap: 1.2em;
    }
    .hero-ia__sub-line {
      font-size: clamp(11px, 3vw, 14px);
    }
    .hero-ia__footer {
      left: clamp(16px, 4vw, 32px);
    }
  }

  /* ── アクセシビリティ ─────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-ia__scroll-line { animation: none; }
    .hero-ia__catch,
    .hero-ia__footer {
      transition: none;
    }
  }
</style>

<script>
(function () {
  'use strict'

  /* ── Guard ─────────────────────────────── */
  var section = document.getElementById('hero-ia')
  var canvas  = document.getElementById('hero-ia-cv')
  if (!section || !canvas) return
  var ctx = canvas.getContext('2d')

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (reduced) {
    section.querySelectorAll('.hero-ia__sub-line').forEach(function (l) {
      l.classList.add('is-shown')
    })
    section.classList.add('is-done')
    return
  }

  /* ── 低解像度スケール ───────────────────
     Canvas を 35% で描画し CSS で 100% に拡大、
     filter:blur がにじみを作る               */
  var SCALE = 0.35
  var LW = 0, LH = 0   // section の論理サイズ
  var CW = 0, CH = 0   // canvas バッファサイズ

  /* ── 状態 ──────────────────────────────── */
  var startTime = null
  var isActive  = false
  var autoTimer = null
  var animId    = null

  /* ─────────────────────────────────────────
     フィールド定義
     [type, bx, by, mr, maxA, sa, gd, trA]
       type : 'w'水 / 'l'葉 / 'f'火
       bx,by: 正規化位置（0–1）
       mr   : 最大半径（CH の倍率）
       maxA : 中心の最大 alpha
       sa   : 発生時刻（s、起動後）
       gd   : 成長時間（s）
       trA  : 痕跡として残る最低 alpha
  ───────────────────────────────────────── */
  var DEFS = [
    /* 水 ── 画面下部全体に幅広く広がる（0.3〜4s）*/
    ['w', 0.08, 0.80, 0.41, 0.46, 0.3, 2.8, 0.07],
    ['w', 0.26, 0.84, 0.44, 0.50, 0.7, 3.0, 0.07],
    ['w', 0.46, 0.78, 0.47, 0.54, 1.1, 3.0, 0.08],
    ['w', 0.64, 0.82, 0.45, 0.50, 1.5, 3.0, 0.07],
    ['w', 0.82, 0.79, 0.42, 0.46, 1.9, 2.8, 0.06],
    ['w', 0.96, 0.75, 0.38, 0.40, 2.3, 2.8, 0.05],

    /* 葉 ── 水の上から生い茂る（4〜8s）*/
    ['l', 0.12, 0.55, 0.31, 0.44, 4.0, 3.2, 0.05],
    ['l', 0.32, 0.48, 0.35, 0.48, 4.5, 3.2, 0.05],
    ['l', 0.53, 0.52, 0.34, 0.46, 5.0, 3.2, 0.05],
    ['l', 0.72, 0.50, 0.32, 0.42, 5.5, 3.0, 0.04],
    ['l', 0.90, 0.56, 0.27, 0.36, 6.5, 2.8, 0.04],

    /* 火 ── 葉の内部に宿る熾火（7.5〜11s）*/
    ['f', 0.34, 0.53, 0.17, 0.28, 7.5, 2.8, 0.03],
    ['f', 0.55, 0.50, 0.15, 0.25, 9.0, 2.6, 0.03],
    ['f', 0.71, 0.55, 0.13, 0.22, 10.5, 2.4, 0.02],
  ]

  /* 各 type の色 [R, G, B] */
  var COL = {
    w: [132, 188, 224],   /* 水 — 朝霞の青 */
    l: [82,  135, 84 ],   /* 葉 — 苔・若葉の緑 */
    f: [194, 104, 38 ],   /* 火 — 熾火の橙 */
  }

  /* ── フィールドインスタンス ─────────────── */
  var FIELDS = null
  var SPARKS = []   /* クリック時の一時的な火花 */

  /* ── ユーティリティ ─────────────────────── */
  function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v }
  function easeOut(t) { t = clamp(t, 0, 1); return 1 - Math.pow(1 - t, 2.6) }
  function rgba(col, a) {
    a = a < 0 ? 0 : a > 1 ? 1 : a
    return 'rgba(' + col[0] + ',' + col[1] + ',' + col[2] + ',' + a.toFixed(3) + ')'
  }

  /* ── フィールド初期化 ────────────────────── */
  function initFields() {
    FIELDS = DEFS.map(function (d) {
      return {
        type: d[0], bx: d[1], by: d[2],
        x: d[1] * CW, y: d[2] * CH,
        r: d[3] * CH,
        maxA: d[4], sa: d[5], gd: d[6], trA: d[7],
        wobX: Math.random() * 6.283,
        wobY: Math.random() * 6.283,
        wobSpd: 0.18 + Math.random() * 0.22,
      }
    })
    SPARKS = []
  }

  function refreshFieldCoords() {
    if (!FIELDS) return
    DEFS.forEach(function (d, i) {
      FIELDS[i].x = d[1] * CW
      FIELDS[i].y = d[2] * CH
      FIELDS[i].r = d[3] * CH
    })
  }

  /* ── リサイズ ───────────────────────────── */
  function resize() {
    LW = section.clientWidth  || window.innerWidth
    LH = section.clientHeight || window.innerHeight
    CW = Math.round(LW * SCALE)
    CH = Math.round(LH * SCALE)
    canvas.width  = CW
    canvas.height = CH
    if (!FIELDS) initFields()
    else refreshFieldCoords()
  }

  /* ── 描画 ───────────────────────────────── */
  function draw(now) {
    animId = requestAnimationFrame(draw)

    /* 白紙をベースに */
    ctx.fillStyle = '#FFFDF8'
    ctx.fillRect(0, 0, CW, CH)

    if (!isActive || !startTime) return

    var elapsed = (now - startTime) / 1000
    var wt      = now * 0.001   /* 連続波形時間 */

    /* 雪のヴェール（11〜19s で展開）*/
    var snowP = easeOut(clamp((elapsed - 11) / 8, 0, 1))

    /* ── フィールド描画 ─────────────────── */
    for (var i = 0; i < FIELDS.length; i++) {
      var f = FIELDS[i]
      if (elapsed < f.sa) continue

      var growT  = clamp((elapsed - f.sa) / f.gd, 0, 1)
      var radius = f.r * easeOut(growT)
      if (radius < 0.5) continue

      /* 透明度: 成長 → 雪に引き下げられ痕跡へ */
      var peakA = f.maxA * easeOut(growT)
      var alpha = f.trA + (peakA - f.trA) * (1 - snowP * 0.85)
      if (alpha < 0.003) continue

      /* 有機的な揺れ */
      var wx = f.x + Math.sin(wt * f.wobSpd         + f.wobX) * radius * 0.09
      var wy = f.y + Math.sin(wt * f.wobSpd * 0.71  + f.wobY) * radius * 0.07

      var col = COL[f.type]
      var g   = ctx.createRadialGradient(wx, wy, 0, wx, wy, radius)
      g.addColorStop(0,    rgba(col, alpha))
      g.addColorStop(0.38, rgba(col, alpha * 0.72))
      g.addColorStop(0.74, rgba(col, alpha * 0.28))
      g.addColorStop(1,    rgba(col, 0))
      ctx.fillStyle = g

      /* 描画矩形をキャンバス内に収める */
      var rx = Math.max(0, wx - radius)
      var ry = Math.max(0, wy - radius)
      ctx.fillRect(rx, ry, Math.min(CW - rx, radius * 2), Math.min(CH - ry, radius * 2))
    }

    /* ── 火花（クリック時のみ）───────────── */
    for (var i = SPARKS.length - 1; i >= 0; i--) {
      var s   = SPARKS[i]
      var age = elapsed - s.born
      if (age > s.life) { SPARKS.splice(i, 1); continue }
      var p   = age / s.life
      var sa  = p < 0.28 ? (p / 0.28) * s.maxA : s.maxA * (1 - (p - 0.28) / 0.72)
      var sr  = s.r * easeOut(Math.min(1, p / 0.35))
      var sg  = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, sr)
      sg.addColorStop(0, rgba(COL['f'], sa))
      sg.addColorStop(1, rgba(COL['f'], 0))
      ctx.fillStyle = sg
      ctx.fillRect(Math.max(0, s.x - sr), Math.max(0, s.y - sr), sr * 2, sr * 2)
    }

    /* ── 雪のヴェール：白く包む ─────────────
       全体に均一に広がり、色をゆっくり覆う
       trA で痕跡がヴェールの奥に残る            */
    if (snowP > 0.003) {
      ctx.fillStyle = 'rgba(250,248,244,' + (snowP * 0.68).toFixed(3) + ')'
      ctx.fillRect(0, 0, CW, CH)
    }

    /* ── アニメーション完了（〜19s）──────── */
    if (snowP >= 1.0 && elapsed > 20) {
      cancelAnimationFrame(animId)
      animId = null
      section.classList.add('is-done')   /* h1 + フッター出現 */
    }
  }

  /* ── サブコピー出現スケジュール ─────────── */
  var copyTimers = []
  function scheduleCopies() {
    section.querySelectorAll('.hero-ia__sub-line').forEach(function (el) {
      var t = parseFloat(el.getAttribute('data-t') || '0')
      copyTimers.push(setTimeout(function () {
        el.classList.add('is-shown')
      }, t * 1000))
    })
  }

  /* ── 起動 ───────────────────────────────── */
  function activate() {
    if (isActive) return
    isActive  = true
    startTime = performance.now()
    if (autoTimer) { clearTimeout(autoTimer); autoTimer = null }
    scheduleCopies()
  }

  /* ── 火花（クリック時）─────────────────── */
  function addSpark(clientX, clientY) {
    if (!isActive || !startTime) return
    var r       = section.getBoundingClientRect()
    var elapsed = (performance.now() - startTime) / 1000
    for (var k = 0; k < 2; k++) {
      SPARKS.push({
        x:    (clientX - r.left + (Math.random() - 0.5) * LW * 0.04) * SCALE,
        y:    (clientY - r.top  + (Math.random() - 0.5) * LH * 0.04) * SCALE,
        r:    (0.05 + Math.random() * 0.04) * CH,
        maxA: 0.22 + Math.random() * 0.08,
        born: elapsed,
        life: 1.2 + Math.random() * 0.7,
      })
    }
  }

  /* ── イベント ───────────────────────────── */
  section.addEventListener('mousemove', function () { activate() })

  section.addEventListener('click', function (e) {
    activate()
    addSpark(e.clientX, e.clientY)
  })

  section.addEventListener('touchstart', function (e) {
    activate()
  }, { passive: true })

  /* ── リサイズ ───────────────────────────── */
  if (window.ResizeObserver) {
    new ResizeObserver(resize).observe(section)
  } else {
    window.addEventListener('resize', resize)
  }
  resize()

  /* ── タブ非表示時に一時停止 ─────────────── */
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) {
      cancelAnimationFrame(animId); animId = null
    } else if (!animId && isActive && !section.classList.contains('is-done')) {
      animId = requestAnimationFrame(draw)
    }
  })

  /* ── 起動 ───────────────────────────────── */
  animId = requestAnimationFrame(draw)

  /* 4秒後に自動開始（カーソル操作なしの場合）*/
  autoTimer = setTimeout(function () {
    if (!isActive) activate()
  }, 4000)

})()
</script>
